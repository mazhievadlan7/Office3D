# Meta Architectural Authority — platform env (example).
# Скопируйте в platform/.env и заполните out-of-band. НИЧЕГО секретного не коммитить.
# Файл .env игнорируется (.gitignore: .env* / !.env.example).

# --- Control plane (Этаж 27, Security Core) --------------------------------
PLATFORM_TOKEN=                       # обязателен для control-plane; задать вне репозитория
PLATFORM_HOST=127.0.0.1               # только loopback
PLATFORM_PORT=8787
PLATFORM_DATA_DIR=./platform/.data
PLATFORM_GATE0=off                    # Gate-0 tripwire (TZ §II.14) — off по умолчанию
PLATFORM_GATE0_TARGETS=
PLATFORM_AUTOSTOP_THRESHOLD=0         # авто-стоп по аномалиям (TZ §II.4.2) — 0 = выкл
PLATFORM_AUTOSTOP_WINDOW_MS=60000

# --- Archive (TZ §II.3.4 / §22) — ПАМЯТЬ платформы -------------------------
# Пайплайн archive_ingestion загружает СПРАВОЧНЫЕ МЕТАДАННЫЕ каталога в pgvector
# (семантический поиск) и Neo4j (граф Domain->Unit->Level). БД пока НЕ подняты:
# доступен только `python ingest_archive.py --dry-run` (запись в БД не идёт).
ARCHIVE_JSON=./platform/archive/unified_ai_hacker_mind_v5.json

# pgvector (профиль docker-compose `archive`; поднимать только при провижене БД)
PG_DSN=postgresql://aegis:CHANGE_ME@localhost:5432/aegis_archive
PG_PASSWORD=                          # для docker-compose профиля archive

# Neo4j (профиль docker-compose `archive`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=
NEO4J_PASSWORD=                       # для docker-compose профиля archive

# --- Эмбеддинги: по умолчанию ЛОКАЛЬНЫЕ (суверенно, данные не уходят наружу) -
# Модель НЕ скачивается автоматически; dry-run её не требует.
EMBED_PROVIDER=local                  # local | openai
EMBED_MODEL=intfloat/multilingual-e5-large   # RU+EN, 1024 dim
EMBED_DIM=1024                        # ДОЛЖЕН совпадать с vector(N) в schema.sql
# EMBED_PROVIDER=openai (опционально; можно локальный OpenAI-совместимый сервер):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=sk-none

# Канонический governance (единый источник = platform/core/governance.js,
# экспортируется в этот файл; emit_system_prompt.py предпочитает его).
AEGIS_GOVERNANCE_JSON=./platform/archive/governance.json

# --- Dev LLM через Ollama (ЗАГЛУШКА — вызовов пока нет) ---------------------
# Локальный суверенный LLM для будущей оркестрации; код его ещё не вызывает.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
