# Browser/client gateway URL (build-time — requires `npm run build` after changes)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# Runtime gateway URL — takes effect on restart without a rebuild.
# Use this instead of NEXT_PUBLIC_GATEWAY_URL when you want to change the
# gateway endpoint without re-running `npm run build`.
# OFFICE3D_GATEWAY_URL=ws://localhost:18789
# OFFICE3D_GATEWAY_TOKEN=
# Optional: tell Studio which backend that runtime gateway URL represents.
# Valid values: openclaw, hermes, demo, custom. Defaults to hermes when
# HERMES_API_URL is set, otherwise openclaw.
# OFFICE3D_GATEWAY_ADAPTER_TYPE=hermes
# Gateway hosts the Studio proxy may connect to (host names, comma-separated).
# Required in production for OpenClaw or any remote gateway: with it empty the
# proxy refuses every upstream. The built-in Hermes does not need it.
# UPSTREAM_ALLOWLIST=gateway.example.ts.net

# --- Hermes Agent (default backend) -----------------------------------------
# Office3D talks to Hermes from its own server; nothing here reaches the
# browser. docker-compose.yml fills the URLs in; set only the secrets there.
# See docs/hermes-platform.md.
#
# Hermes API server (runs, sessions, scheduled jobs).
# HERMES_API_URL=http://127.0.0.1:8642
# The default profile's API_SERVER_KEY. Hermes refuses keys under 16
# characters. Generate with: openssl rand -hex 32
# HERMES_API_KEY=
# Hermes dashboard backend (profiles = agents, kanban). Without it the office
# has only the main agent.
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# HERMES_DASHBOARD_TOKEN=
# Office3D derives each agent profile's API key from this secret, so no
# per-agent key is stored. Changing it re-keys every agent on next use.
# Generate with: openssl rand -hex 32
# OFFICE3D_HERMES_KEY_SECRET=
# Office3D's MCP server: the team tools Hermes agents call (propose a hire or
# a dismissal, list the team). Internal only — never publish it. Defaults:
# 127.0.0.1:3010, and Hermes reaches it at http://127.0.0.1:3010. In Docker
# compose sets 0.0.0.0 and http://office3d:3010.
# OFFICE3D_MCP_HOST=127.0.0.1
# OFFICE3D_MCP_PORT=3010
# OFFICE3D_MCP_URL=http://127.0.0.1:3010
# Time zone for autonomy's active hours and daily budget (IANA name, e.g.
# Europe/Moscow). Defaults to the server's own zone.
# OFFICE3D_TIMEZONE=
# Hermes image the compose file runs; the office offers newer releases and
# the updater service rewrites this line when you press «Обновить».
# HERMES_IMAGE_TAG=v2026.9.21
# Token between office3d and the updater service (docker-compose.yml).
# Generate with: openssl rand -hex 32
# OFFICE3D_UPDATER_TOKEN=

# Debug UI
DEBUG=true

# App server
# PORT=3000
# HOST=127.0.0.1

# Optional: required only for public/remote deployments
# STUDIO_ACCESS_TOKEN=
# With the token set: a login name asked for at /login next to the password
# (the password is STUDIO_ACCESS_TOKEN), and the name the HQ greets you by
# after signing in (defaults to the login).
# STUDIO_LOGIN=
# STUDIO_OWNER_NAME=

# --- HTTPS on your own domain (docker compose) -------------------------------
# Turns on the caddy service, which gets and renews a Let's Encrypt
# certificate for the domain. Point the domain's DNS at the server and open
# ports 80 and 443 first. See docs/deployment.md.
# COMPOSE_PROFILES=https
# OFFICE3D_DOMAIN=office.example.com
# The office's address as others see it. MCP servers with OAuth sign-in send
# the browser back to <this>/oauth/mcp/<server>; empty means the address the
# office is opened on, which is right unless it is opened by several names.
# OFFICE3D_PUBLIC_URL=https://office.example.com

# --- Backups (docker compose) --------------------------------------------------
# Daily at this time (HH:MM, empty turns them off), in this zone (default:
# OFFICE3D_TIMEZONE, else UTC), keeping this many. scripts/office3d-backup.sh
# lists them, takes one now and restores one.
# BACKUP_TIME=03:30
# BACKUP_TIMEZONE=Europe/Moscow
# BACKUP_KEEP=7

# --- Maintenance ---------------------------------------------------------------
# The server cleans its own disk litter and reports its memory (the HQ's
# archive cart shows it). It touches only a fixed allowlist: in development
# the .next/dev trace and log (truncated when large), old hot-update files and
# this repo's leftover test temp folders; everywhere, leftover voice temp
# folders and orphaned settings/tasks .tmp files. Settings, tasks, uploads and
# everything else are never deleted, only measured.
# on (default) cleans; report only measures and logs what it would clean;
# off does no file work at all.
# OFFICE3D_MAINTENANCE=on
# Set to off to keep the unit tests' temp folders (development only).
# OFFICE3D_MAINTENANCE_TEST_TEMP=on

# --- Alerts ------------------------------------------------------------------------
# The office checks Hermes, backups, disk space and updates every minute and
# alerts on every channel set here. "Settings -> System status" shows the same
# and sends a test alert.
# Push to your phone with ntfy: install the ntfy app and subscribe to a long,
# random topic name — on ntfy.sh that name is the only secret.
# ALERT_NTFY_URL=https://ntfy.sh/<long-random-topic>
# ALERT_NTFY_TOKEN=
# E-mail through SMTP (for Gmail: an app password, and %40 for the @ in the user).
# ALERT_SMTP_URL=smtps://you%40gmail.com:<app-password>@smtp.gmail.com:465
# ALERT_EMAIL_TO=you@gmail.com
# ALERT_EMAIL_FROM=
# Dead man's switch: a healthchecks.io (or compatible) ping URL. It alerts you
# when the pings stop, i.e. when the whole server is down.
# ALERT_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# Advanced only: some gateway-host operations can still use SSH, but marketplace skill install does not require it.
# OPENCLAW_GATEWAY_SSH_TARGET=
# OPENCLAW_GATEWAY_SSH_USER=
# OPENCLAW_GATEWAY_SSH_PORT=
# OPENCLAW_GATEWAY_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Demo gateway (no OpenClaw or Hermes required)
# Run `npm run demo-gateway` and connect Office3D to ws://localhost:18789
# DEMO_ADAPTER_PORT=18789
# If OFFICE3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# Voice — speech recognition (the microphone) and the HQ's voices — comes from
# the office's own speech gateway (services/speech): open-source engines on
# this machine or the office server, no paid API, no keys.
#   silero:<speaker>    Silero TTS v5: the HQ system voice, exact Russian stress, fast on CPU
#   voicestudio:<name>  VoiceStudio: AM7's and the crew's designed voices, and speech recognition
# Install once with scripts/speech-setup.ps1 (Windows) or scripts/speech-setup.sh,
# then run `npm run speech` next to `npm run dev`. See docs/deployment.md.
# Default http://127.0.0.1:8765; docker compose uses http://speech:8765 unless
# this is set, so leave it unset there.
# SPEECH_GATEWAY_URL=http://127.0.0.1:8765
# Where speech-setup installed the engines (outside the repo). Default:
# %LOCALAPPDATA%\office3d-speech on Windows, ~/.local/share/office3d-speech elsewhere.
# OFFICE3D_SPEECH_HOME=
# The HQ system's own voice («Система штаба») and the voice AM7 speaks with
# when none is picked in settings:
# OFFICE3D_SYSTEM_VOICE=silero:aidar
# OFFICE3D_TTS_VOICE=voicestudio:am7
# Recognition language hint (ISO code):
# OFFICE3D_STT_LANGUAGE=ru
# Speech gateway / VoiceStudio settings read by `npm run speech` (defaults shown):
# SPEECH_PORT=8765
# VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_MODEL=voxcpm2
# SILERO_DEVICE=cpu            # cpu | cuda | auto
# Only when VoiceStudio is reached over a network with its API key set:
# VOICESTUDIO_API_KEY=
#
# Alternatives: any other server with OpenAI's audio API, per direction, or
# OpenClaw's own pipeline for recognition:
# OFFICE3D_STT_PROVIDER=local-speech     # local-speech | openai-compatible | openclaw
# OFFICE3D_TTS_PROVIDER=local-speech     # local-speech | openai-compatible
# OFFICE3D_VOICE_API_URL=http://127.0.0.1:8000/v1   # or OFFICE3D_STT_API_URL / OFFICE3D_TTS_API_URL
# OFFICE3D_VOICE_API_KEY=
# OFFICE3D_STT_MODEL=whisper-1
# OFFICE3D_TTS_MODEL=tts-1
# OFFICE3D_TTS_VOICES=alloy,echo,fable,onyx,nova,shimmer

# --- Credentials -----------------------------------------------------------
# Office3D reads these; see src/lib/credentials/catalog.ts for what each one
# affects, and GET /api/credentials to check which are set on a running host.
# Never commit values: this file is the template, .env is git-ignored.

# Raises GitHub's 60 req/hour anonymous limit when browsing or installing
# skills, and is required for a private repository.
# GITHUB_TOKEN=

# Used by skills and agents, not by Office3D itself. A skill that needs a key
# for one tool is better served by its own per-skill key in Studio's skill
# setup, which scopes it to that skill instead of every process.
# HIGGSFIELD_API_KEY=
# YOUTUBE_API_KEY=
# QWEN_API_KEY=

# Public address of this office, for sign-in redirects that come back from
# outside (e.g. Hermes MCP OAuth). Optional.
# OFFICE3D_PUBLIC_URL=https://office.example.com
